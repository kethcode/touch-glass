# Touch Glass configuration
# Copy to .env and fill in your values

# Password for the web UI (required)
BRAIN_PASSWORD=changeme

# SQLite database path. Defaults to ./brain.db when unset.
# BRAIN_DB=/home/lain/touch-glass/brain.db

# Chrome CDP URL (default: http://localhost:9222)
CDP_URL=http://localhost:9222

# Your X/Twitter username for scraping own tweets and followers
TWITTER_USERNAME=your_username

# Monitor feature flags
TOUCH_GLASS_ENABLE_TIMELINE=true
TOUCH_GLASS_ENABLE_BOOKMARKS=true
TOUCH_GLASS_ENABLE_OWN_TWEETS=true
TOUCH_GLASS_ENABLE_FOLLOWERS=true
TOUCH_GLASS_ENABLE_LINKEDIN=true
TOUCH_GLASS_ENABLE_TELEGRAM=true
TOUCH_GLASS_ENABLE_DIGEST=true
TOUCH_GLASS_CYCLE_SECONDS=600
TOUCH_GLASS_CYCLE_JITTER_SECONDS=180
TOUCH_GLASS_TASK_JITTER_SECONDS=7
TOUCH_GLASS_TIMELINE_PAGES=5
TOUCH_GLASS_BOOKMARKS_PAGES=8
TOUCH_GLASS_OWN_TWEETS_PAGES=5

# Topic/event detection for Hermes handoff (optional)
TOUCH_GLASS_TOPICS_CONFIG=topics/index.json
TOUCH_GLASS_HERMES_CONSOLIDATION_PROMPT=prompts/hermes_consolidation.md
TOUCH_GLASS_HERMES_COMMENTARY_PROMPT=prompts/hermes_commentary.md
TOUCH_GLASS_HERMES_MARK_DELIVERED=true
TOUCH_GLASS_HERMES_LIMIT=25
TOUCH_GLASS_HERMES_WINDOW_MINUTES=120
# Optional final handoff gates. Priority is usually a better first lever than score.
# TOUCH_GLASS_HERMES_MIN_PRIORITY=7
# TOUCH_GLASS_HERMES_MIN_SCORE=20

# Python used by Hermes handoff. Leave unset for .venv or system python fallback.
# For uv-managed deployments, uncomment:
# TOUCH_GLASS_PYTHON_CMD="uv run python"
# Alternative direct interpreter path:
# TOUCH_GLASS_PYTHON=/home/lain/touch-glass/.venv/bin/python

# Email digest via Resend (optional)
RESEND_API_KEY=
DIGEST_EMAIL=you@example.com
DIGEST_FROM="Touch Glass <onboarding@resend.dev>"

# Embeddings / semantic search (optional)
# disabled | openai | llamacpp | auto
# auto enables OpenAI only when OPENAI_API_KEY is set.
EMBEDDING_PROVIDER=disabled

# Local llama.cpp OpenAI-compatible embedding server.
# Start llama-server separately, then set EMBEDDING_PROVIDER=llamacpp.
EMBEDDING_BASE_URL=http://127.0.0.1:8080/v1
EMBEDDING_MODEL=Qwen3-Embedding-0.6B-Q8_0
EMBEDDING_DIMS=native
EMBEDDING_MAX_CHARS=6000
# EMBEDDING_TIMEOUT=120
# EMBEDDING_API_KEY=
# EMBEDDING_QUERY_INSTRUCTION="Retrieve relevant social feed items, links, and contacts for the given query."

# OpenAI fallback (optional): set EMBEDDING_PROVIDER=openai.
OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
